# OpenAI (required when OpenAI is the embedding or LLM service)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_EMBEDDING_DIMENSIONS=3072

# Perplexity (optional)
PERPLEXITY_API_KEY=your_perplexity_api_key_here
# PERPLEXITY_CHAT_MODEL=sonar
# Perplexity embeddings are only used if a model is set here
# PERPLEXITY_EMBEDDING_MODEL=
# PERPLEXITY_EMBEDDING_DIMENSIONS=1024

# Ollama (optional - defaults shown)
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=codellama:7b
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_EMBEDDING_DIMENSIONS=768

# OpenSearch (defaults shown)
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
